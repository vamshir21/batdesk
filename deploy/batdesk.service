[Unit]
Description=BatDesk FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vamshi-yadav
Group=vamshi-yadav
WorkingDirectory=/home/vamshi-yadav/batdesk/backend
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/home/vamshi-yadav/batdesk/scripts/batdesk-run.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
